# Drives swish through a real pty to check job control and line editing.
# Run from the repo root after `swift build`, or via scripts/test.sh.
set timeout 5
log_user 0
# A scratch history file, so tests never touch ~/.swish_history.
set env(SWISH_HISTORY) [exec mktemp]
spawn .build/debug/swish
# The end of a success prompt: directory, then a green arrow.
set ok {\x1b\[0m \x1b\[32m}
set failures 0
proc step {name pattern} {
  expect {
    -re $pattern { puts "ok   $name" }
    timeout { puts "FAIL $name"; global failures; incr failures }
  }
}
expect -re $ok
send "sleep 0.3\r"
# Input is highlighted, so match around the escapes between words.
step "fg command runs, no spurious stop" "0\\.3.*\\n.*$ok"
send "cat\r"
send "typed-into-cat\r"
step "cat owns the terminal (no SIGTTIN)" "typed-into-cat\r\n.*typed-into-cat"
send "\x04"
step "cat exits on ^D" $ok
send "sleep 30\r"
after 300
send "\x03"
step "^C kills the job, not the shell" {\[130\]}
send "sleep 30 | cat\r"
after 300
send "\x1a"
step "^Z stops the pipeline" {Stopped +sleep 30 \| cat}
send "jobs\r"
step "jobs lists it" {\[1\]  Stopped +sleep 30 \| cat}
send "fg\r"
after 300
send "\x03"
step "fg resumes and ^C ends it" {\[130\]}
send "echo one\r"
send "\x1b\[A\x01\x1b\[3~\x1b\[3~\x1b\[3~\x1b\[3~X\r"
step "history + line editing" "X: command not found"
send "let n = 3\r"
send "if n > 2 {\r"
step "an open block asks for more" {\x1b\[90m}
send "echo \"big \\(n)\"\r"
send "}\r"
step "the block runs once closed" "\nbig 3\r\n"
send "if true {\r"
send "\x03"
send "echo after\r"
step "^C discards a pending block" "\nafter\r\n"
send "while true {}\r"
# ^C typed before the editor has handed the terminal back is just a queued
# byte, not a signal, so give the loop time to start.
after 1000
send "\x03"
step "^C stops a loop running in the shell itself" {\[130\]}
send "func greet(_ name: String) { echo \"hi \\(name)\" }\r"
send "greet Rak\r"
step "functions persist between prompts" "\nhi Rak\r\n"
send "exit 7\r"
# A shell that doesn't exit (a failed step left it busy) is killed, so a
# failure can't hang the suite.
expect {
  eof {}
  timeout { exec kill -9 [exp_pid] }
}
lassign [wait] pid spawnid os code
if {$code != 7} { puts "FAIL exit status: $code"; incr failures } else { puts "ok   exit status" }
exit [expr {$failures > 0}]
