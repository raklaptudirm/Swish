# A script stopped by ^C, kill or hangup runs its `defer`s, then ends by
# the signal. Run from the repo root after `swift build`, or via `run test`.
set timeout 10
log_user 0
set failures 0
set env(SWISH_HISTORY) ""
set env(SWISH_CONFIG) ""
set script [exec mktemp]
set file [open $script w]
# The loop says when it's running: a signal sent before then could be lost.
# It says so with a value, not a command, whose end would take the signal.
puts $file {defer { echo "cleaned up" }
var spins = 0
while true { if spins == 0 { print("started") }; spins += 1 }}
close $file

foreach signal {INT TERM HUP} {
  spawn .build/debug/swish $script
  expect "started"
  set pid [exp_pid]
  exec kill -$signal $pid
  expect {
    "cleaned up" { puts "ok   SIG$signal runs the script's defer" }
    timeout {
      # Its state, if it's still there, then gone, so a failure never hangs.
      if {[catch {exec ps -o stat=,sigcatch= -p $pid} state]} { set state "exited" }
      puts "FAIL SIG$signal runs the script's defer ($state)"
      incr failures
      catch {exec kill -9 $pid}
    }
  }
  expect eof
  # Killed by the signal itself, as it would have been without the defer.
  set result [wait]
  if {[lindex $result 4] eq "CHILDKILLED" && [lindex $result 5] eq "SIG$signal"} {
    puts "ok   and it ends by SIG$signal"
  } else {
    puts "FAIL it ended with $result"; incr failures
  }
}

file delete $script
exit [expr {$failures > 0}]
