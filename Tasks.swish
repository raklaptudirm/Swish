// Tasks for working on Swish: `run` lists them, `run test` runs one. Before
// Swish is built, or from another shell: swift run swish -c 'run test'

let root = FilePath(#filePath).removingLastComponent()
cd $root

/// `swift test` for a package. With only the Command Line Tools installed,
/// swift-testing isn't on the default search paths, so it's given them.
func _swiftTest(_ package: String) throws {
    let tools = "/Library/Developer/CommandLineTools"
    if $(uname).text == "Darwin" && $(xcode-select -p).text == tools {
        let frameworks = tools + "/Library/Developer/Frameworks"
        let libraries = tools + "/Library/Developer/usr/lib"
        try swift test --package-path $package -Xswiftc "-F\(frameworks)" -Xlinker "-F\(frameworks)" -Xlinker -rpath -Xlinker $frameworks -Xlinker -rpath -Xlinker $libraries
    } else {
        try swift test --package-path $package
    }
}

/// Runs every test. Both packages' unit tests, then the shell built and
/// driven through a real terminal by the expect scripts (on Linux, install
/// expect first).
func test() {
    try! _swiftTest(".")
    try! _swiftTest("Packages/SwishKit")
    try! swift build
    for script in ["job-control", "line-editor", "background-jobs"] {
        try! expect "Tests/Interactive/\(script).exp"
    }
}

/// Writes a module's symbol graph into `graphs`. SystemPackage is found
/// among what `swift build` built, with the C module it imports.
func _graph(_ module: String, into graphs: String) throws {
    let machine = $(uname -m).text
    let built = $(swift build --show-bin-path).text
    let csystem = ".build/checkouts/swift-system/Sources/CSystem/include"
    if $(uname).text == "Darwin" {
        let sdk = $(xcrun --show-sdk-path).text
        let extract = $(xcrun --find swift-symbolgraph-extract).text
        try $extract -module-name $module -target "\(machine)-apple-macosx14.0" -sdk $sdk -I $built -I "\(built)/Modules" -I $csystem -output-dir $graphs
    } else {
        try swift-symbolgraph-extract -module-name $module -target "\(machine)-unknown-linux-gnu" -I $built -I "\(built)/Modules" -I $csystem -output-dir $graphs
    }
}

/// Regenerates the bridges in Sources/SwishCore/Bridge: StandardLibrary.swift
/// from the standard library's symbol graph, and SystemPackage.swift from
/// swift-system's, for FilePath. Run it after changing swish-bridge, the
/// Swift toolchain or swift-system. The checked-in files are made on macOS;
/// Linux's modules have the same members.
func bridge() {
    let graphs = $(mktemp -d).text
    defer { rm -rf $graphs }
    try! swift build
    try! _graph("Swift", into: graphs)
    try! _graph("SystemPackage", into: graphs)
    try! swift run -c release swish-bridge "\(graphs)/Swift.symbols.json" Sources/SwishCore/Bridge/StandardLibrary.swift
    try! swift run -c release swish-bridge "\(graphs)/SystemPackage.symbols.json" Sources/SwishCore/Bridge/SystemPackage.swift
}
