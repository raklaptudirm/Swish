// Tasks for working on Swish: `run` lists them, `run test` runs one. Before
// Swish is built, or from another shell: swift run swish -c 'run test'

let root = FilePath(#filePath).removingLastComponent()
cd $root
let darwin = $(uname).text == "Darwin"

/// Runs every test. The shell's unit tests and the SwishKit compatibility
/// package's (Swiit's own run in its repository, ../Swiit), then the shell
/// built and driven through a real terminal by the expect scripts (on Linux,
/// install expect first).
func test() {
    try! _swiftTest(".")
    try! _swiftTest("Packages/SwishKit")
    try! swift build
    for script in ["job-control", "line-editor", "background-jobs", "config", "signals"] {
        try! expect "Tests/Interactive/\(script).exp"
    }
}

/// Regenerates the shell's bridges in Sources/SwishShell/Bridge/Generated, from
/// the symbol graph of the shell's own module, SwishShellLibrary, with the
/// generator from Swiit (../Swiit, which regenerates its own with its
/// Scripts/bridge). Run it after changing the shell's library or the Swift
/// toolchain. A graph is read on the platform it's made on, so each
/// platform's members are kept in Bridges/<platform>, and what's bridged is
/// what all the platforms there have: CI makes Linux's (see
/// .github/workflows/ci.yml), and a member only one has can't break the other.
func bridge() {
    let platform = darwin ? "macos" : "linux"
    let graphs = $(mktemp -d).text
    defer { rm -rf $graphs }
    try! swift build
    let module = "SwishShellLibrary"
    try! _graph(module, into: graphs)
    var platforms = ["--manifest", "Bridges/\(platform)/\(module).json"]
    for other in ["macos", "linux"] {
        let manifest = "Bridges/\(other)/\(module).json"
        if other != platform && $(^test -f $manifest).status.succeeded { platforms += ["--also", manifest] }
    }
    try! swift run --package-path ../Swiit -c release swiit-bridge "\(graphs)/\(module).symbols.json" "Sources/SwishShell/Bridge/Generated/ShellLibrary.swift" $platforms
}

/// `swift test` for a package. With only the Command Line Tools installed,
/// swift-testing isn't on the default search paths, so it's given them.
func _swiftTest(_ package: String) throws {
    let tools = "/Library/Developer/CommandLineTools"
    var flags: [String] = []
    if darwin && $(xcode-select -p).text == tools {
        let frameworks = tools + "/Library/Developer/Frameworks"
        let libraries = tools + "/Library/Developer/usr/lib"
        flags = ["-Xswiftc", "-F\(frameworks)", "-Xlinker", "-F\(frameworks)",
                 "-Xlinker", "-rpath", "-Xlinker", frameworks, "-Xlinker", "-rpath", "-Xlinker", libraries]
    }
    try swift test --package-path $package $flags
}

/// Writes a module's symbol graph into `graphs`. SystemPackage is found
/// among what `swift build` built, with the C module it imports.
func _graph(_ module: String, into graphs: String) throws {
    let machine = $(uname -m).text
    let built = $(swift build --show-bin-path).text
    let search = ["-I", built, "-I", "\(built)/Modules", "-I", ".build/checkouts/swift-system/Sources/CSystem/include"]
    if darwin {
        let sdk = $(xcrun --show-sdk-path).text
        let extract = $(xcrun --find swift-symbolgraph-extract).text
        try $extract -module-name $module -target "\(machine)-apple-macosx14.0" -sdk $sdk $search -output-dir $graphs
    } else {
        try swift-symbolgraph-extract -module-name $module -target "\(machine)-unknown-linux-gnu" $search -output-dir $graphs
    }
}
