// Tasks for working on Swish: `run` lists them, `run test` runs one. Before
// Swish is built, or from another shell: swift run swish -c 'run test'

let root = FilePath(#filePath).removingLastComponent()
cd $root
let darwin = $(uname).text == "Darwin"

/// Runs every test. The shell's unit tests (Swiit's own run in its
/// repository, ../Swiit), then the shell built and driven through a real
/// terminal by the expect scripts (on Linux, install expect first).
func test() {
    try! _swiftTest(".")
    try! swift build
    for script in ["job-control", "line-editor", "background-jobs", "config", "signals"] {
        try! expect "Tests/Interactive/\(script).exp"
    }
}

/// `swift test` for a package. With only the Command Line Tools installed,
/// swift-testing isn't on the default search paths, so it's given them.
func _swiftTest(_ package: String) throws {
    let tools = "/Library/Developer/CommandLineTools"
    var flags: [String] = []
    if darwin && $(xcode-select -p).text == tools {
        let frameworks = tools + "/Library/Developer/Frameworks"
        let libraries = tools + "/Library/Developer/usr/lib"
        flags = ["-Xswiftc", "-F\(frameworks)", "-Xlinker", "-F\(frameworks)",
                 "-Xlinker", "-rpath", "-Xlinker", frameworks, "-Xlinker", "-rpath", "-Xlinker", libraries]
    }
    try swift test --package-path $package $flags
}
