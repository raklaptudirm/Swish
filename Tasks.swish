// Tasks for working on Swish: `run` lists them, `run test` runs one. Before
// Swish is built, or from another shell: swift run swish -c 'run test'

let root = FilePath(#filePath).removingLastComponent()
cd $root
let darwin = $(uname).text == "Darwin"

/// Runs every test. Both packages' unit tests, then the shell built and
/// driven through a real terminal by the expect scripts (on Linux, install
/// expect first).
func test() {
    try! _swiftTest(".")
    try! _swiftTest("Packages/SwishKit")
    try! swift build
    for script in ["job-control", "line-editor", "background-jobs", "config", "signals"] {
        try! expect "Tests/Interactive/\(script).exp"
    }
}

/// Regenerates the bridges in Sources/Swiit/Bridge/Generated (and the
/// shell's own in Sources/SwishShell/Bridge/Generated), from the symbol
/// graphs of the standard library, Foundation, swift-system and the shell's
/// own modules. Run it after changing swiit-bridge, the Swift
/// toolchain or swift-system. A graph is read on the platform it's made on,
/// so each platform's members are kept in Bridges/<platform>, and what's
/// bridged is what all the platforms there have: CI makes Linux's (see
/// .github/workflows/ci.yml), and a member only one has can't break the other.
func bridge() {
    let platform = darwin ? "macos" : "linux"
    let graphs = $(mktemp -d).text
    defer { rm -rf $graphs }
    try! swift build
    // Other modules that extend a module's types, whose graphs are read with
    // it; the shell's own also declares types the extensions use.
    let extensions = ["Swift": ["_StringProcessing", "SwishStandardLibrary"], "Foundation": ["SwishStandardLibrary", "SwishKit"]]
    let declaresTypes = ["SwishStandardLibrary"]
    // A module's types can be defined in a module it re-exports, which some
    // platforms don't have: Foundation's Date is FoundationEssentials' on
    // Linux. Their graphs are read with it, and what adds to them is too.
    let reexports = ["Foundation": ["FoundationEssentials"]]
    func exists(_ file: String) -> Bool { $(^test -f $file).status.succeeded }
    for module in ["Swift", "SystemPackage", "SwishKit", "Foundation", "SwishStandardLibrary", "SwishShellLibrary"] {
        try! _graph(module, into: graphs)
        var extra: [String] = []
        var hosts = [module]
        for host in reexports[module] ?? [] {
            let made = try? _graph(host, into: graphs)
            if exists("\(graphs)/\(host).symbols.json") {
                hosts.append(host)
                extra.append("\(graphs)/\(host).symbols.json")
            }
        }
        for other in extensions[module] ?? [] {
            try! _graph(other, into: graphs)
            for host in hosts {
                let file = "\(graphs)/\(other)@\(host).symbols.json"
                if exists(file) { extra.append(file) }
            }
            if declaresTypes.contains(other) { extra.append("\(graphs)/\(other).symbols.json") }
        }
        let outputs = ["Swift": "StandardLibrary", "SwishStandardLibrary": "SwishLibrary", "SwishShellLibrary": "ShellLibrary"]
        let output = outputs[module] ?? module
        // The core's bridges are in the core; the shell's library is the shell's.
        let target = module == "SwishShellLibrary" ? "SwishShell" : "Swiit"
        // This platform's members to write, and the others' to keep to.
        var platforms = ["--manifest", "Bridges/\(platform)/\(module).json"]
        for other in ["macos", "linux"] {
            let manifest = "Bridges/\(other)/\(module).json"
            if other != platform && $(^test -f $manifest).status.succeeded { platforms += ["--also", manifest] }
        }
        try! swift run -c release swiit-bridge "\(graphs)/\(module).symbols.json" "Sources/\(target)/Bridge/Generated/\(output).swift" $extra $platforms
    }
}

/// `swift test` for a package. With only the Command Line Tools installed,
/// swift-testing isn't on the default search paths, so it's given them.
func _swiftTest(_ package: String) throws {
    let tools = "/Library/Developer/CommandLineTools"
    var flags: [String] = []
    if darwin && $(xcode-select -p).text == tools {
        let frameworks = tools + "/Library/Developer/Frameworks"
        let libraries = tools + "/Library/Developer/usr/lib"
        flags = ["-Xswiftc", "-F\(frameworks)", "-Xlinker", "-F\(frameworks)",
                 "-Xlinker", "-rpath", "-Xlinker", frameworks, "-Xlinker", "-rpath", "-Xlinker", libraries]
    }
    try swift test --package-path $package $flags
}

/// Writes a module's symbol graph into `graphs`. SystemPackage is found
/// among what `swift build` built, with the C module it imports.
func _graph(_ module: String, into graphs: String) throws {
    let machine = $(uname -m).text
    let built = $(swift build --show-bin-path).text
    let search = ["-I", built, "-I", "\(built)/Modules", "-I", ".build/checkouts/swift-system/Sources/CSystem/include"]
    if darwin {
        let sdk = $(xcrun --show-sdk-path).text
        let extract = $(xcrun --find swift-symbolgraph-extract).text
        try $extract -module-name $module -target "\(machine)-apple-macosx14.0" -sdk $sdk $search -output-dir $graphs
    } else {
        try swift-symbolgraph-extract -module-name $module -target "\(machine)-unknown-linux-gnu" $search -output-dir $graphs
    }
}
