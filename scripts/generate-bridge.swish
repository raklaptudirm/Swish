#!/usr/bin/env swish
// Regenerates Sources/SwishCore/Bridge/StandardLibrary.swift from the
// standard library's symbol graph, for the toolchain in use. Run it after
// changing swish-bridge or the Swift toolchain:
//
//   swift build && .build/debug/swish scripts/generate-bridge.swish

let root = $(dirname "\(#filePath)").text + "/.."
cd $root

let graphs = $(mktemp -d).text
defer { rm -rf $graphs }

// The checked-in file is made on macOS; Linux's standard library has the
// same members, and a file made there differs only in what's left out.
let machine = $(uname -m).text
// try! stops the script if a step fails, as `set -e` would.
if $(uname).text == "Darwin" {
    let sdk = $(xcrun --show-sdk-path).text
    let extract = $(xcrun --find swift-symbolgraph-extract).text
    try! $extract -module-name Swift -target "\(machine)-apple-macosx14.0" -sdk $sdk -output-dir $graphs
} else {
    try! swift-symbolgraph-extract -module-name Swift -target "\(machine)-unknown-linux-gnu" -output-dir $graphs
}
try! swift run -c release swish-bridge "\(graphs)/Swift.symbols.json" Sources/SwishCore/Bridge/StandardLibrary.swift
